# Leave empty in local dev (Vite proxies /api to localhost:8000).
# In production set to your deployed backend, e.g. https://support-copilot-api.onrender.com
VITE_API_URL=
# Only if you set APP_API_KEY on the backend. Note: anything in a frontend bundle is public,
# so this is a demo gate, not real authentication.
VITE_API_KEY=

# --- required for answers ---
GOOGLE_API_KEY=  your_google_api_key_here
# --- optional ---
TAVILY_API_KEY=  your_tavily_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite   # switch to a full Flash model if tool calls get flaky
EMBED_MODEL=gemini-embedding-001
# --- your own data (defaults: backend/data/blinkit.db and backend/data/policy.pdf; demo data is generated if missing) ---
# BLINKIT_DB=/path/to/blinkit.db
# POLICY_PDF=/path/to/Blinkit Policy and FAQ.pdf
# --- deployment ---
CORS_ORIGINS=https://support-copilot-ai-agent-rag.vercel.app     # comma separated, add your Vercel URL in production
APP_API_KEY=                            # optional shared secret (header X-API-Key)
RATE_LIMIT_PER_MIN=20
AGENT_MAX_STEPS=8
